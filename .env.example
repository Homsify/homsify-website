# ─────────────────────────────────────────────────────────────────────────────
#  HOMSIFY — environment variables
#
#  These are NEVER committed to git. They are set in the Netlify dashboard:
#  Netlify → your project → Project configuration → Environment variables.
#
#  This file is only a checklist of what needs to exist there.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Supabase → Project Settings → API) ─────────────────────────────
# SUPABASE_URL is the "Project URL".
# SUPABASE_SERVICE_ROLE_KEY is the service_role secret — click "reveal" to see
# it. Treat it like a bank password: it has full read/write on the lead table.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Email ────────────────────────────────────────────────────────────────────
# "brevo" (free, works with a Gmail sender address) or "resend" (needs a
# verified domain). Set BREVO_API_KEY or RESEND_API_KEY to match.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-...
# RESEND_API_KEY=re_...

EMAIL_FROM_NAME=Homsify
EMAIL_FROM_ADDRESS=hellohomsify@gmail.com
EMAIL_INTERNAL=hellohomsify@gmail.com

# ── Optional: Cloudflare Turnstile anti-bot ──────────────────────────────────
# Leave unset. The form already has a honeypot and rate limiting, and the
# function skips the Turnstile check entirely when this is absent.
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
